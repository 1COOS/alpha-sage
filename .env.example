APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=7777
WEB_ORIGIN=http://localhost:8888
DATABASE_URL=sqlite:///./data/alpha_sage.db
ARTIFACT_ROOT=./data/artifacts
RAW_DATA_ROOT=./data/raw

# OpenAI-compatible model provider. The API key may instead be saved through the
# local UI into the operating-system keychain.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_MODE=responses
REASONING_MODEL=gpt-5.2
FAST_MODEL=gpt-5-mini

# Runtime safety. A fresh account is paused regardless of this value.
SCHEDULER_ENABLED=true
LIVE_SOURCE_SMOKE_ENABLED=false

# Free public data endpoints are versioned settings and may be replaced without
# changing domain code.
EASTMONEY_BASE_URL=https://push2his.eastmoney.com
EASTMONEY_LIST_URL=https://80.push2.eastmoney.com
TENCENT_QUOTE_URL=https://qt.gtimg.cn
TENCENT_HISTORY_URL=https://web.ifzq.gtimg.cn/appstock/app/fqkline/get
